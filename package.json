{
  "name": "lumora-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:status": "supabase migration list",
    "db:ship": "supabase db push && echo '\\n✓ Migrations aplicadas e validadas'",
    "deploy": "npm run build && git add -A && (git diff --cached --quiet || git commit -m \"deploy: $(date +'%Y-%m-%d %H:%M')\") && git push origin main && echo '\\n✓ Push feito. Vercel vai buildar em ~60s → https://vercel.com/dashboard'"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "heic2any": "^0.0.4",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
